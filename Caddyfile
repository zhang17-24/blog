# ============================================================
# 站点地址由环境变量 SITE_ADDRESS 控制，一份配置支持两种模式：
#
#   有域名（自动申请并续期 HTTPS 证书）：
#     SITE_ADDRESS=blog.example.com
#     SITE_ADDRESS=blog.example.com, www.blog.example.com   ← 多域名用逗号分隔
#
#   还没域名（纯 HTTP，用 IP 访问）：
#     SITE_ADDRESS=:80
#
# 默认值是 :80 —— 没配置也能跑起来，不会因为忘设变量而启动失败。
# 切换方式：改服务器上 /opt/blog/.env 里的这一行，然后
#   docker compose up -d --force-recreate web
#
# 注意：域名模式要求域名已解析到本机；国内服务器还需完成 ICP 备案，
# 否则 80/443 会被云厂商的未备案监测系统拦截。
# 完整流程见 docs/DOMAIN-SETUP.md
# ============================================================
{$SITE_ADDRESS::80} {
	root * /srv/blog

	# 压缩传输
	encode zstd gzip

	# cleanUrls 打开后，/posts/hello 实际对应 posts/hello.html，
	# 少了这行直接访问文章页会 404
	try_files {path} {path}.html {path}/index.html /404.html

	file_server

	# 带 hash 的静态资源可以放心长期缓存（文件名变了内容才变）
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML 不缓存，保证改完立刻生效
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
